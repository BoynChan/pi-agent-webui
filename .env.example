# Backend listen address. Secrets never belong here.
PI_DEBUG_HOST=127.0.0.1
PI_DEBUG_PORT=8787

# Optional: override CORS origin (Vite default).
PI_DEBUG_CORS_ORIGIN=http://127.0.0.1:5173

# Runtime: "pi" (default) embeds @earendil-works/pi-coding-agent.
# Set "stub" for the in-process demo catalog with no filesystem tools.
PI_DEBUG_RUNTIME=pi

# Working directory for AGENTS.md and coding tools (read/bash/edit/write).
# Skills load only from ~/.pi/agent/skills (or PI_AGENT_DIR/skills).
# Defaults to the process cwd (this repo when you run `pnpm dev`).
# PI_DEBUG_CWD=/Users/you/code/your-project

# Optional override for ~/.pi/agent
# PI_AGENT_DIR=/Users/you/.pi/agent
